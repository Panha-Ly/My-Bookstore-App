<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color when the item IS checked/selected -->
    <item
        android:state_checked="true"
        android:drawable="@color/accentColor" />

    <!-- Background color when the item IS NOT checked (stays default/transparent) -->
    <item
        android:drawable="@android:color/transparent" />
</selector>
